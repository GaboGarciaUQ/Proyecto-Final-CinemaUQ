<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.uniquindio.proyectofinalp2.cinemauq.controlador.AdminPeliculasController" spacing="16" style="-fx-padding: 24 32 32 32;">
    <Label text="Películas" styleClass="titulo"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtTitulo" promptText="Título" prefWidth="220"/>
        <TextField fx:id="txtDuracion" promptText="Duración (min)" prefWidth="120"/>
        <TextField fx:id="txtPoster" promptText="URL del poster (opcional)" prefWidth="280"/>
        <Button text="Agregar" styleClass="boton-primario" onAction="#agregar"/>
        <Button text="Guardar cambios" styleClass="boton-secundario" onAction="#guardar"/>
        <Button text="Eliminar" styleClass="boton-secundario" onAction="#eliminar"/>
    </HBox>
    <TableView fx:id="tblPeliculas" VBox.vgrow="ALWAYS"/>
</VBox>