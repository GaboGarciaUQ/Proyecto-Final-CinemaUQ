<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uniquindio.proyectofinalp2.cinemauq.controlador.ConfiteriaController"
            styleClass="fondo">
    <top>
        <fx:include source="BarraSuperiorView.fxml"/>
    </top>
    <center>
        <HBox spacing="20">
            <padding>
                <Insets top="20" right="24" bottom="24" left="24"/>
            </padding>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-transparente" HBox.hgrow="ALWAYS">
                <VBox spacing="12">
                    <padding>
                        <Insets right="8"/>
                    </padding>
                    <Label text="Confitería" styleClass="titulo-seccion"/>
                    <Label text="Opcional. Agrega productos o combos a tu compra." styleClass="texto-suave"/>
                    <Label text="COMBOS" styleClass="etiqueta-campo"/>
                    <VBox fx:id="listaCombos" spacing="10"/>
                    <Label text="PRODUCTOS" styleClass="etiqueta-campo"/>
                    <VBox fx:id="listaProductos" spacing="10"/>
                </VBox>
            </ScrollPane>

            <VBox styleClass="panel" spacing="12" prefWidth="320" minWidth="320" maxWidth="320">
                <Label fx:id="lblPelicula" styleClass="titulo-seccion" wrapText="true"/>
                <Label fx:id="lblFuncion" styleClass="texto-suave" wrapText="true"/>
                <Label text="RESUMEN" styleClass="etiqueta-campo"/>
                <VBox fx:id="lineasResumen" spacing="6"/>
                <Region VBox.vgrow="ALWAYS"/>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Entradas" styleClass="texto-suave" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label fx:id="lblEntradas" styleClass="precio"/>
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Confitería" styleClass="texto-suave" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label fx:id="lblConfiteria" styleClass="precio"/>
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label text="SUBTOTAL" styleClass="etiqueta-campo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label fx:id="lblTotal" styleClass="total"/>
                </HBox>
                <Label fx:id="lblPuntos" styleClass="texto-suave"/>
                <Button fx:id="btnContinuar" text="CONTINUAR" styleClass="boton-primario"
                        maxWidth="Infinity" onAction="#continuar"/>
                <Button text="VOLVER" styleClass="boton-secundario" maxWidth="Infinity" onAction="#volver"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
