<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uniquindio.proyectofinalp2.cinemauq.controlador.AsientosController"
            styleClass="fondo">
    <top>
        <fx:include source="BarraSuperiorView.fxml"/>
    </top>
    <center>
        <HBox spacing="20">
            <padding>
                <Insets top="20" right="24" bottom="24" left="24"/>
            </padding>

            <VBox styleClass="panel" spacing="14" HBox.hgrow="ALWAYS" alignment="TOP_CENTER">
                <Label fx:id="lblEncabezado" styleClass="subtitulo"/>
                <Region styleClass="pantalla-cine" prefHeight="8" maxWidth="460"/>
                <Label text="PANTALLA" styleClass="texto-suave"/>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-transparente" VBox.vgrow="ALWAYS">
                    <StackPane fx:id="zonaMapa" alignment="TOP_CENTER"/>
                </ScrollPane>
                <HBox fx:id="leyenda" spacing="22" alignment="CENTER"/>
            </VBox>

            <VBox styleClass="panel" spacing="12" prefWidth="320" minWidth="320" maxWidth="320">
                <Label fx:id="lblPelicula" styleClass="titulo-seccion" wrapText="true"/>
                <Label fx:id="lblFuncion" styleClass="texto-suave" wrapText="true"/>
                <Label text="ASIENTOS SELECCIONADOS" styleClass="etiqueta-campo"/>
                <FlowPane fx:id="chipsSeleccionados" hgap="6" vgap="6"/>
                <Label fx:id="lblVacio" text="Aún no has elegido asientos" styleClass="texto-suave"/>
                <Region VBox.vgrow="ALWAYS"/>
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="lblCantidad" styleClass="texto-suave" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label fx:id="lblSubtotal" styleClass="precio"/>
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label text="TOTAL" styleClass="etiqueta-campo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label fx:id="lblTotal" styleClass="total"/>
                </HBox>
                <Label fx:id="lblPuntos" styleClass="texto-suave"/>
                <Label fx:id="lblError" styleClass="error-texto" wrapText="true"/>
                <Button fx:id="btnContinuar" text="CONTINUAR" styleClass="boton-primario"
                        maxWidth="Infinity" onAction="#continuar"/>
                <Button text="VOLVER" styleClass="boton-secundario" maxWidth="Infinity" onAction="#volver"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
