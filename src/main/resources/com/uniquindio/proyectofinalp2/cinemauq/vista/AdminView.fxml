<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.uniquindio.proyectofinalp2.cinemauq.controlador.AdminController">
    <top>
        <HBox styleClass="barra-superior" alignment="CENTER_LEFT" spacing="20">
            <Label text="CinemaUQ" styleClass="logo"/>
            <Label text="PANEL DE ADMINISTRACIÓN" styleClass="insignia"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblNombre" styleClass="texto-suave"/>
            <Button text="Salir" styleClass="boton-texto" onAction="#salir"/>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Reportes y estadísticas"><content><fx:include source="AdminReportesTab.fxml"/></content></Tab>
            <Tab text="Películas"><content><fx:include source="AdminPeliculasTab.fxml"/></content></Tab>
            <Tab text="Funciones y salas"><content><fx:include source="AdminFuncionesTab.fxml"/></content></Tab>
            <Tab text="Confitería y promociones"><content><fx:include source="AdminConfiteriaTab.fxml"/></content></Tab>
            <Tab text="Clientes y recargas"><content><fx:include source="AdminClientesTab.fxml"/></content></Tab>
            <Tab text="Puntos"><content><fx:include source="AdminPuntosTab.fxml"/></content></Tab>
        </TabPane>
    </center>
</BorderPane>
