<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.uniquindio.proyectofinalp2.cinemauq.controlador.AdminConfiteriaController" fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="14" style="-fx-padding: 24 32 32 32;">
        <Label text="Productos" styleClass="titulo"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtProducto" promptText="Nombre" prefWidth="260"/>
            <TextField fx:id="txtPrecio" promptText="Precio" prefWidth="120"/>
            <Button text="Agregar" styleClass="boton-primario" onAction="#agregarProducto"/>
            <Button text="Guardar cambios" styleClass="boton-secundario" onAction="#guardarProducto"/>
            <Button text="Eliminar" styleClass="boton-secundario" onAction="#eliminarProducto"/>
        </HBox>
        <TableView fx:id="tblProductos" prefHeight="190"/>

        <Label text="Combos" styleClass="titulo" style="-fx-padding: 12 0 0 0;"/>
        <HBox spacing="10" alignment="TOP_LEFT">
            <VBox spacing="10">
                <TextField fx:id="txtCombo" promptText="Nombre del combo" prefWidth="240"/>
                <TextField fx:id="txtDescCombo" promptText="Descuento (%)" prefWidth="240"/>
                <Button text="Crear combo" styleClass="boton-primario" maxWidth="Infinity" onAction="#crearCombo"/>
                <Button text="Eliminar combo" styleClass="boton-secundario" maxWidth="Infinity" onAction="#eliminarCombo"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Componentes (Ctrl+clic para varios)" styleClass="etiqueta-campo"/>
                <ListView fx:id="lstComponentes" prefWidth="260" prefHeight="150"/>
            </VBox>
            <TableView fx:id="tblCombos" prefHeight="190" HBox.hgrow="ALWAYS"/>
        </HBox>

        <Label text="Promociones" styleClass="titulo" style="-fx-padding: 12 0 0 0;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtPromo" promptText="Nombre" prefWidth="260"/>
            <TextField fx:id="txtPorcentaje" promptText="Descuento (%)" prefWidth="120"/>
            <Button text="Agregar" styleClass="boton-primario" onAction="#agregarPromo"/>
            <Button text="Guardar cambios" styleClass="boton-secundario" onAction="#guardarPromo"/>
            <Button text="Eliminar" styleClass="boton-secundario" onAction="#eliminarPromo"/>
        </HBox>
        <TableView fx:id="tblPromos" prefHeight="170"/>
    </VBox>
</ScrollPane>
