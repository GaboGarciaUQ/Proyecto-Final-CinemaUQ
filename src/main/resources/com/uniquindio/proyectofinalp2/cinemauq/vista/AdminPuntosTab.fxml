<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.uniquindio.proyectofinalp2.cinemauq.controlador.AdminPuntosController" spacing="12" maxWidth="460" style="-fx-padding: 24 32 32 32;">
    <Label text="Programa de puntos" styleClass="titulo"/>
    <Label text="Regla de acumulación" styleClass="titulo-seccion"/>
    <Label text="Valor gastado por bloque" styleClass="etiqueta-campo"/>
    <TextField fx:id="txtValor"/>
    <Label text="Puntos ganados por bloque" styleClass="etiqueta-campo"/>
    <TextField fx:id="txtPuntos"/>
    <Button text="Guardar regla" styleClass="boton-primario" onAction="#guardarRegla"/>
    <Label text="Equivalencias para redimir" styleClass="titulo-seccion" style="-fx-padding: 12 0 0 0;"/>
    <Label text="Puntos por entrada" styleClass="etiqueta-campo"/>
    <TextField fx:id="txtEntrada"/>
    <Label text="Puntos por producto" styleClass="etiqueta-campo"/>
    <TextField fx:id="txtProducto"/>
    <Label text="Puntos por combo" styleClass="etiqueta-campo"/>
    <TextField fx:id="txtCombo"/>
    <Button text="Guardar equivalencias" styleClass="boton-primario" onAction="#guardarEquivalencias"/>
    <Label fx:id="lblMensaje" styleClass="exito-texto"/>
</VBox>
